{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch Enotes",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Enotes.Api/bin/Debug/net10.0/Enotes.Api",
      "args": [],
      "cwd": "${workspaceFolder}/src/Enotes.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
